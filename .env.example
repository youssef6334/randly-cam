# Set these in the hosting environment; the app does not load .env automatically.
NODE_ENV=production
PORT=3000
MAX_CONN_PER_IP=8
# Exact source addresses/CIDRs of your ingress; never 0.0.0.0/0 or ::/0.
# Local reverse proxy example only: 127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=
# Enable only after restricting origin access and verifying CF header rewriting.
BEHIND_CLOUDFLARE=false
# Private persistent storage, outside public/.
DATA_DIR=./data
IP_HASH_SALT=
# TURN REST authentication; same shared secret on coturn.
TURN_URLS=
TURN_SHARED_SECRET=
# Optional server-side keys. Configure provider spending quotas.
GOOGLE_TRANSLATE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Pick models supported by your provider account. The Groq default is a preview model.
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.5-flash-lite
# Time to search for another person before offering the AI character, 1000-30000 ms.
AI_WAIT_MS=6000
AI_HEALTH_TOKEN=
EXIT_ON_UNCAUGHT=true
